# Copy to .env for local development outside Docker
SERVICE_NAME=service
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recsys
POSTGRES_USER=recsys
POSTGRES_PASSWORD=recsys

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka / Redpanda (use external listener port when running outside Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_EVENTS=user-events
KAFKA_GROUP_ID=recsys-group

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=raw-events

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# API
API_PORT=8000
METRICS_PORT=9000
RECOMMENDATION_LIMIT_DEFAULT=10
